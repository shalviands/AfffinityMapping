# ============================================
# INCUBX AFFINITY MAPPING TOOL — Environment
# ============================================

# --- REQUIRED: OpenRouter (one key for all AI) ---
# Get free key at: openrouter.ai — no credit card needed
VITE_OPENROUTER_API_KEY=sk-or-your-key-here

# --- AI Models (all have free defaults — change only if needed) ---
# These are all FREE models. Only change if you want paid quality.
VITE_MODEL_EXTRACTION=google/gemma-3-27b-it:free
VITE_MODEL_CLUSTERING=meta-llama/llama-3.3-70b-instruct:free
VITE_MODEL_SYNTHESIS=google/gemma-3-27b-it:free
VITE_MODEL_EXPORT=openrouter/free
VITE_MODEL_FALLBACK=google/gemini-2.0-flash-lite-001
VITE_MODEL_PREMIUM=anthropic/claude-haiku-4.5

# --- Transcription: Bhashini (free, Indian languages) ---
# Register at: bhashini.gov.in → ULCA → API
VITE_BHASHINI_API_KEY=your-bhashini-api-key
VITE_BHASHINI_USER_ID=your-bhashini-user-id
VITE_BHASHINI_PIPELINE_ID=your-pipeline-id

# --- Transcription: Groq Whisper (free tier, fast) ---
# Get free key at: console.groq.com — generous free tier
VITE_GROQ_API_KEY=gsk_your-groq-key-here

# --- Transcription: OpenAI Whisper (paid, $0.006/min — optional fallback) ---
VITE_OPENAI_API_KEY=sk-your-openai-key-here

# --- Embeddings: Gemini (free: 1500 req/day) ---
# Get at: aistudio.google.com → Get API key
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# --- Firebase (set region to asia-south1 before creating!) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# --- App ---
VITE_APP_URL=https://incubx.in
VITE_LMS_WEBHOOK_URL=https://your-incubx-lms.com/api/webhooks/affinity

